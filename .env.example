# ---- SkillMatrix: configuración ----
# Copia este archivo como .env y ajusta los valores.

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASEDEDATOS
DATABASE_URL=postgresql://skillmatrix:cambia-esta-clave@localhost:5432/skillmatrix

# Contraseña del usuario "admin" que se crea la primera vez (cámbiala después desde la web).
ADMIN_PASSWORD=admin

# 1 = cargar datos de ejemplo la primera vez; 0 = empezar vacío.
SKILLMATRIX_DEMO=1

# Interfaz y puerto donde escucha la aplicación. Detrás de un proxy inverso usa HOST=127.0.0.1.
HOST=0.0.0.0
PORT=5000

# Peticiones simultáneas que atiende cada instancia y conexiones a la base de datos (DB_POOL_SIZE >= THREADS).
THREADS=8
DB_POOL_SIZE=10

# Solo si otras aplicaciones llaman a la API DESDE EL NAVEGADOR (JavaScript) en otro dominio.
# Lista separada por comas, p. ej.: https://intranet.empresa.com,https://portal.empresa.com
CORS_ORIGINS=

# 1 si se publica detrás de HTTPS (cookies solo por conexión segura).
COOKIE_SECURE=0
